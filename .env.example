# Bind to localhost for private, single-machine use.
HOST=127.0.0.1
PORT=4173
NODE_ENV=development
DATABASE_PATH=./data/nightjar.sqlite
RAMMERHEAD_HOST=127.0.0.1
RAMMERHEAD_PORT=4174
# For production, set APP_ORIGIN and RAMMERHEAD_ORIGIN to two distinct HTTPS origins.
# APP_ORIGIN=https://nightjar.example.com
# RAMMERHEAD_ORIGIN=https://browse.example.com

# Required only the first time an administrator is initialized. Use at least
# 16 characters; this value is not used for normal logins after initialization.
ADMIN_INITIAL_PASSWORD=replace-with-a-long-random-password

# Optional RFC 6238 authenticator-app secret, base32 encoded. Set it before
# first startup to require a one-time code for administrator sign-in.
# ADMIN_TOTP_SECRET=

# Local-only AI. When enabled, Nightjar starts `ollama serve` on loopback
# if no local Ollama API is already available. It never downloads the model.
OLLAMA_AUTOSTART=1
OLLAMA_MODEL=qwen3:4b
# Optional full path if `ollama` is not on PATH:
# OLLAMA_BINARY=/usr/bin/ollama

# Optional Linux desktop companion pairing secret. Generate a random 32-byte
# hex value and use the same value for Nightjar and the local companion.
# The companion is manual-start only, loopback-bound, and does not enable RDP.
DESKTOP_COMPANION_SECRET=replace-with-64-hex-characters
